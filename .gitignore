__pycache__/
*.pyc

# Eval output. Rows carry full model responses, so a sweep is tens of MB and
# churns constantly -- keep the harness in git, not the data it produces.
results/*.jsonl
results/*.bak
results/prompts_sent/

# Scratch from the simulators.
obj_dir/
*.vvp

# refs/ is DELIBERATELY TRACKED -- do not add it here.
# It holds the Phase 0 vendored reference RTL, pinned by SHA in refs.lock.
# The benchmark's claim to rigor is that every testbench was proven against
# externally-authored known-correct RTL; a refs.lock naming a tree we cannot
# restore is a manifest for nothing. Egress is closed after Phase 0, so an
# untracked refs/ is unrecoverable. All vendored subtrees are
# SHL-0.51 / Apache-2.0 / MIT / BSD / NVDLA Open HW -- redistributable with
# attribution, and each subtree carries its upstream LICENSE alongside.
#
# GPL/LGPL sources (ZipCPU cordic, dspfilters) are NEVER vendored here; they
# are consulted in a scratch dir outside the repo, recorded in refs.lock.
