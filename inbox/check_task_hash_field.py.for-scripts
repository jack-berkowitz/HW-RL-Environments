#!/usr/bin/env python3
"""Refuse a task.yaml whose recorded task_text_hash no longer matches the text.

    check_task_hash_field.py                 every task with a task.yaml
    check_task_hash_field.py <task_dir>...   just these

WHY THIS EXISTS
---------------
AGENT-VERIF-A2 recomputed four hashes rather than taking them from a message,
found they disagreed with the `task_text_hash:` field recorded beside them, and
swept the corpus:

    recorded field == recomputed       2 of 21
    recorded field is STALE            3
    NO task_text_hash FIELD AT ALL    16

On the design half it was worse -- five stale, three missing, none correct. Two
of the five recorded that morning's value exactly: they were right until a spec
edit landed and went stale in the same commit that made them wrong.

THE FIELD IS NOT UNREAD. IT IS READ AND BELIEVED.
------------------------------------------------
This is the inverse of the usual failure here. `exclusive:` is a field nothing
parses, so it can be wrong forever and no one notices. `task_text_hash:` is a
field people DO read -- it is the first place anyone looks when asking "is this
task's prompt the one that submission answered" -- and it silently stops being
true whenever spec/ or probe/PASTE.md changes.

d_ai01's field carried, one line above the value:

    # Recompute with scripts/task_text_hash.py at the point of use

Somebody already knew. The disclaimer did not help, because a disclaimer next to
a value that looks like an answer loses to the value. THE FIX FOR A FIELD THAT
GOES STALE IS NOT A WARNING, IT IS A CHECK.

WHAT IT DOES NOT DO
-------------------
It does not tell you whether a RESULT is comparable -- that is
report_table.py's stale-prompt guard, which compares the hash stamped into a run
record against the current text. This checks the DECLARATION in task.yaml, which
is a different thing that happens to hold the same kind of value.

A missing field is reported and does not fail: not every task declares one, and
inventing a policy that they must is a bigger decision than this script.
A field that is present and WRONG fails, because that is a false statement.
"""
import os, re, subprocess, sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
HASHER = os.path.join(REPO, "scripts", "task_text_hash.py")
# MATCH THE FIELD, THEN VALIDATE THE VALUE -- two steps, deliberately.
#
# The first version folded them into one pattern that required [0-9a-f]{8,}
# directly, so a field present with a value it could not parse -- a YAML-quoted
# hash, a placeholder, a typo -- came back the same as no field at all.
# ABSENT IS A LEGITIMATE STATE THAT 14 TASKS OCCUPY, so an unparseable field
# landed in a PLAUSIBLE bucket and would never have been looked at. That is the
# in-range failure class: had it produced an implausible answer it would have
# been found in seconds.
#
# AGENT-VERIF-A2 lost two rows to exactly this on the same field -- their scan
# anchored at column 0, missed two indented declarations, and reported them
# ABSENT. Same bucket, different cause.
FIELD_LINE = re.compile(r"^\s*task_text_hash:\s*(.*)$", re.M)
HASHVAL    = re.compile(r"^[0-9a-f]{8,}$")

MISSING, MALFORMED = object(), object()


def recorded(task_dir):
    """None-> no field. MALFORMED-> field present, value unparseable. else the hash."""
    p = os.path.join(task_dir, "task.yaml")
    if not os.path.isfile(p):
        return None
    m = FIELD_LINE.search(open(p, encoding="utf-8", errors="replace").read())
    if not m:
        return None
    raw = m.group(1)
    raw = raw.split("#", 1)[0]                  # drop a trailing comment
    raw = raw.strip().strip(chr(34)).strip(chr(39)).strip()   # and YAML quoting
    return raw if HASHVAL.match(raw) else MALFORMED


def computed(task_dir):
    r = subprocess.run([sys.executable, HASHER, task_dir],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return None
    first = r.stdout.strip().split("\n")[0].strip()
    return first if re.fullmatch(r"[0-9a-f]{8,}", first) else None


SELFTEST = [
    ("column 0",             "task_text_hash: aaaaaaaaaaaaaaaa\n",                  "aaaaaaaaaaaaaaaa"),
    ("indent 2",             "  task_text_hash: bbbbbbbbbbbbbbbb\n",                "bbbbbbbbbbbbbbbb"),
    ("indent 4",             "    task_text_hash: cccccccccccccccc\n",              "cccccccccccccccc"),
    ("tab indent",           "\ttask_text_hash: dddddddddddddddd\n",                "dddddddddddddddd"),
    ("trailing comment",     "task_text_hash: eeeeeeeeeeeeeeee  # spec + prompt\n", "eeeeeeeeeeeeeeee"),
    ("double-quoted",        'task_text_hash: "ffffffffffffffff"\n',                "ffffffffffffffff"),
    ("single-quoted",        "task_text_hash: '1111111111111111'\n",                "1111111111111111"),
    ("quoted + comment",     'task_text_hash: "2222222222222222" # x\n',            "2222222222222222"),
    ("commented out",        "# task_text_hash: 3333333333333333\n",                None),
    ("indented comment",     "  # task_text_hash: 4444444444444444\n",              None),
    ("_before variant",      "task_text_hash_before: 5555555555555555\n",           None),
    ("_after variant",       "  task_text_hash_after: 6666666666666666\n",          None),
    ("prose mention",        "see task_text_hash: 7777777777777777 somewhere\n",    None),
    ("boundary then real",   "task_text_hash_before: 8888888888888888\n"
                             "task_text_hash: 9999999999999999\n",                  "9999999999999999"),
    ("placeholder value",    "task_text_hash: TBD\n",                               "MALFORMED"),
    ("empty value",          "task_text_hash:\n",                                   "MALFORMED"),
    ("truncated hash",       "task_text_hash: abc\n",                               "MALFORMED"),
]


def selftest():
    """Every shape the field has taken, plus the ones that would land in the
    plausible bucket if the parser could not see them."""
    import tempfile
    bad = 0
    for name, text, want in SELFTEST:
        with tempfile.TemporaryDirectory() as d:
            open(os.path.join(d, "task.yaml"), "w").write(text)
            got = recorded(d)
        gots = "MALFORMED" if got is MALFORMED else got
        ok = (gots == want)
        bad += not ok
        print(f"  {'ok  ' if ok else 'FAIL'} {name:20s} got={str(gots):18s} want={want}")
    print(f"\n  selftest: {len(SELFTEST)} case(s), {bad} failing")
    return 1 if bad else 0


def main():
    if "--selftest" in sys.argv:
        return selftest()
    args = [a for a in sys.argv[1:] if not a.startswith("-")]
    if args:
        tasks = args
    else:
        tasks = []
        for kind in ("design", "verification"):
            base = os.path.join(REPO, "domains")
            for dom in sorted(os.listdir(base)):
                d = os.path.join(base, dom, kind)
                if os.path.isdir(d):
                    tasks += [os.path.join(d, t) for t in sorted(os.listdir(d))]
    tasks = [t for t in tasks if os.path.isfile(os.path.join(t, "task.yaml"))]

    stale = missing = ok = 0
    for t in tasks:
        name = os.path.basename(t)
        rec, cmp_ = recorded(t), computed(t)
        if cmp_ is None:
            print(f"  {name:34s} SKIP   the text does not hash (see task_text_hash.py)")
            continue
        if rec is MALFORMED:
            print(f"  {name:34s} MALFORMED  field present, value is not a hash")
            stale += 1
        elif rec is None:
            print(f"  {name:34s} —      no task_text_hash field")
            missing += 1
        elif rec == cmp_:
            print(f"  {name:34s} ok     {rec}")
            ok += 1
        else:
            print(f"  {name:34s} STALE  records {rec}, text hashes to {cmp_}")
            stale += 1

    print(f"\n{len(tasks)} task(s): {ok} correct, {stale} stale, {missing} with no field")
    if stale:
        print("REFUSED: a recorded task_text_hash that no longer matches its text is a")
        print("  FALSE STATEMENT sitting where people look first. Update it, or delete")
        print("  the field -- absent is honest, wrong is not.")
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
