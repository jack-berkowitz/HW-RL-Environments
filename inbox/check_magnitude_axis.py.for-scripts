#!/usr/bin/env python3
"""Refuse a perturbation whose magnitude was justified on a different axis.

    check_magnitude_axis.py PLAN.md

Reads a magnitude table with two axis columns and refuses when they disagree:

    | task | axis perturbed | magnitude | axis the justification is about |
    | v_ca06 | inter-beat gap | 9 | inter-beat gap |          ok
    | v_nw01 | inter-beat gap | 65 | inter-transaction gap |  REFUSE

WHY THIS EXISTS
---------------
`v_nw01`'s depth was 65, justified as "one past REQUEST_RETRY_INTERVAL=64, so a
stall shorter than 64 never lets a retry fire". That is an argument about the gap
BETWEEN REQUESTS. It was applied BETWEEN PAYLOAD BYTES: 28 bytes x 65 = 1820
cycles per frame, against a REQUEST_TIMEOUT of 256. The lookup expired before the
reply finished arriving and the run reported a clause failure.

    ABC units       a real number in the wrong unit
    wrong baseline  a real comparison against the wrong reference
    this            a real justification for a different axis

None is a wrong number. Each is a RIGHT NUMBER DETACHED FROM WHAT MADE IT RIGHT,
and the detachment leaves no trace: the row still carries a citation, the citation
is still true, and it is about something else.

WHY A COLUMN AND NOT CARE
-------------------------
The table already recorded the axis per row. The justification did not carry one,
and that asymmetry is the whole defect. **Care would not have caught it: both
columns were written in one sitting, by one author, and read as agreeing.** A
mismatch is only visible when the two are named in the same vocabulary and
something compares them.

THIS REFUSES. It does not warn. A magnitude with no stated justification axis is
also a refusal -- an unstated axis cannot be checked against anything, and
treating it as agreement is the defect one level up.
"""
import re

# LEADING WHITESPACE IS ALLOWED, AND THE ANCHOR USED TO BE COLUMN 0.
# Every regex in this file was `^`-anchored and every one of them was correct
# only because its input happens to start at column 0 -- Verilator emits
# warnings there, `$display` emits there, markdown tables and headings sit
# there. That is a property of the INPUT, not of the method.
#
# It cost two rows in a corpus sweep: a `task_text_hash:` field indented by two
# and another by four read as ABSENT, which is a legitimate state 14 tasks
# occupy, so the miss landed in a plausible bucket instead of an implausible
# one. AGENT-DESIGN-43a92055's parser had the same defect and their remedy is
# the one taken here: not care, but A CASE LIST THAT FAILS WHEN THE SCOPE
# NARROWS. The self-test below carries indented and tab-indented forms.

import sys

ROW = re.compile(r"^[ \t]*\|\s*`?(\w+)`?\s*\|\s*([^|]+?)\s*\|\s*(\d+)\s*\|\s*([^|]+?)\s*\|", re.M)
NORM = re.compile(r"[^a-z]+")


def norm(s):
    return NORM.sub("", s.lower())


def check(text):
    """-> (rows, mismatches, unstated)"""
    rows, bad, unstated = [], [], []
    for m in ROW.finditer(text):
        task, perturbed, mag, justified = m.groups()
        rows.append((task, perturbed, mag, justified))
        if not justified.strip() or justified.strip() in ("-", "?"):
            unstated.append(task)
        elif norm(perturbed) != norm(justified):
            bad.append((task, perturbed, justified, mag))
    return rows, bad, unstated


def main(argv):
    if not argv:
        sys.exit(__doc__.strip().splitlines()[0])
    rows, bad, unstated = check(open(argv[0], encoding="utf-8").read())
    if not rows:
        print("REFUSED: no magnitude table found in %s." % argv[0])
        print("  A plan with no table cannot be checked, and reporting that as")
        print("  OK is the defect this tool is for.")
        return 2
    print("  %d magnitude row(s) read." % len(rows))
    for task, p, j, mag in bad:
        print("  REFUSE  %-10s perturbs %r at %s, justified on %r" % (task, p, mag, j))
    for task in unstated:
        print("  REFUSE  %-10s states no axis for its justification" % task)
    if bad or unstated:
        print("REFUSED: %d magnitude(s) justified on an axis other than the one "
              "being perturbed." % (len(bad) + len(unstated)))
        print("  A right number detached from what made it right leaves no trace:")
        print("  the citation is still true, and it is about something else.")
        return 2
    print("OK: every magnitude is justified on the axis it perturbs.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
